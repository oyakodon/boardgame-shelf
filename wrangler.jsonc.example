{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boardgame-shelf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "game.servalroom.com",
      "custom_domain": true
    }
  ],
  "dev": {
    "host": "localhost:8787"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/img/*", "/discord/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boardgame-shelf",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "boardgame-shelf-photos"
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "REPLACE_WITH_DISCORD_CLIENT_ID",
    "DISCORD_GUILD_ID": "REPLACE_WITH_DISCORD_GUILD_ID",
    "ADMIN_DISCORD_IDS": "REPLACE_WITH_COMMA_SEPARATED_DISCORD_USER_IDS",
    "DISCORD_PUBLIC_KEY": "REPLACE_WITH_DISCORD_PUBLIC_KEY"
  }
}
